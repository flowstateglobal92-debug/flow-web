# Supabase — Project Settings → API
# Copy this file to .env.local and fill both values in, then restart `next dev`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The publishable / anon key (safe in the browser — RLS does the guarding).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (Project Settings → API → service_role). SERVER ONLY — it
# bypasses row-level security. Used by Team & Users (creating and banning
# accounts), the demo account reset, and the npm scripts. Never prefix it with
# NEXT_PUBLIC_. On Netlify, add it as a secret runtime variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only while moving projects: the old project, for `npm run import:legacy`.
# Delete both once the copy is done.
# OLD_SUPABASE_URL=https://old-project.supabase.co
# OLD_SUPABASE_SERVICE_ROLE_KEY=old-service-role-key

# ── Email ────────────────────────────────────────────────────────────────────
# Powers /admin/email: the inbox, the sent folder, replies and attachments.
#
# In Resend you need, on the same domain:
#   · Sending    — SPF + DKIM records verified (Domains → your domain)
#   · Receiving  — the MX record added, so mail to the address below arrives
# Then create a full-access key at https://resend.com/api-keys.
#
# Nothing else is required: no webhook, no public endpoint. The admin reads
# inbound mail straight from Resend's receiving API, so it works on localhost.
RESEND_API_KEY=re_your_resend_api_key

# The address the mailbox sends from and shows as its own. Must be on a domain
# verified for sending.
EMAIL_FROM_ADDRESS=support@flowstate.lk
EMAIL_FROM_NAME=Flow State

# Optional. Resend's receiving API returns every inbound message on the account;
# set this to a comma-separated list to show only mail addressed to you. Leave
# it empty while testing against a *.resend.app address.
# EMAIL_INBOX_ADDRESSES=support@flowstate.lk,hello@flowstate.lk

# ── Desktop app sync (PowerSync) ─────────────────────────────────────────────
# The password of the read-only database login PowerSync uses (powersync_role).
# Not used by the website or the app — kept here so you can find it again.
# Generate it with:  openssl rand -hex 24
POWERSYNC_DB_PASSWORD=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Overdue payment reminders and monthly client statements go out from
# /api/jobs/run, which netlify/functions/scheduled-jobs.mts calls every hour.
# A long random string (24+ characters), set the same in Netlify's environment
# variables. Without it nothing is sent automatically — and the endpoint
# answers 404 to everyone. Generate one with:  openssl rand -hex 32
# CRON_SECRET=…
