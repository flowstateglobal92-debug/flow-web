# Supabase — Project Settings → API
# Copy this file to .env.local and fill both values in, then restart `next dev`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The publishable / anon key (safe in the browser — RLS does the guarding).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service-role key is NOT used anywhere in this app. Never put it here.
